# Copie para terraform.tfvars e ajuste.
project_id = "seu-projeto-id"

billing_account_id = ""
orcamento_mensal   = 300
moeda_orcamento    = "BRL"

email_alertas = ""

# OCR da nota: local (padrão), vision ou desligado
# motor_ocr = "vision"

# Botão "Analisar com IA" (Gemini) na conferência da nota
# gemini_habilitado = true

# cnpjs_empresa = "12.345.678/0001-90"
# min_instancias = 1   # elimina o "cold start" (custo fixo maior)
# verificacao_disponibilidade = true   # uptime check + alerta de fora do ar (mantém o app sempre ligado)
# db_conexoes_por_instancia = 4   # pool do Prisma por instância; o plan falha se estourar o limite do banco

# Domínio próprio (vazio = URL do Cloud Run)
# app_url = "https://obras.suaempresa.com.br"

# IP fixo do escritório: nunca bloqueado por IP no login (o limite por e-mail continua)
# ips_confiaveis = "200.1.2.3"

# Load Balancer + Cloud Armor (WAF e limite por IP na borda), ~US$ 25/mês. Exige app_url com domínio próprio.
# load_balancer = true
# borda_waf_observacao = false   # depois de conferir os falsos positivos das regras OWASP
# ips_bloqueados_borda = ["203.0.113.7"]

# Varredura de vulnerabilidades das imagens (cobrada por imagem)
# varredura_imagens = true

# Captura automática de NF-e na Sefaz: empresa, certificado A1 e liga/desliga ficam na tela Empresa do app.
# sefaz_agendador = false   # desliga o agendador (padrão: ligado)
