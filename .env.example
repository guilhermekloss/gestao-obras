# Copie para .env. Valores abaixo servem só para desenvolvimento local.

# PostgreSQL do docker-compose.yml
DATABASE_URL=postgresql://obras:obras@localhost:5432/gestao_obras

# Gere com: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Opcional: chave de 32 bytes em base64 para cifrar o certificado A1 (openssl rand -base64 32).
# Sem ela, a chave é derivada do AUTH_SECRET.
# CHAVE_COFRE=

# Opcional: leitura de nota (local | vision | desligado)
# OCR_MOTOR=local

# Opcional: botão "Analisar com IA" (Gemini) — use um dos dois
# GEMINI_PROJETO=
# GEMINI_API_KEY=

# Opcional: CNPJs da empresa para conferir o destinatário da nota
# CNPJS_EMPRESA=

# Opcional: domínio público dos links de convite
# APP_URL=http://localhost:3000

# Rode o servidor em UTC (ver Limitações conhecidas no README)
TZ=UTC
