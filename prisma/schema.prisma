generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ESCRITORIO
  CAMPO
}

enum StatusObra {
  PLANEJAMENTO
  ANDAMENTO
  CONCLUIDA
  PAUSADA
}

enum TipoItem {
  MATERIAL
  SERVICO
  FRETE
  ENCARGO
}

enum FormaPagto {
  PIX
  CARTAO
  DEBITO
  BOLETO
  TRANSFERENCIA
  DINHEIRO
}

enum TipoDocumento {
  NF
  RECIBO
  FOLHA
  GUIA
  OUTRO
}

enum CondicaoTrabalho {
  PRATICAVEL
  PARCIAL
  IMPRATICAVEL
}

enum StatusParcela {
  ABERTA
  PAGA
}

enum FrequenciaCaptura {
  UMA_VEZ_DIA
  DUAS_VEZES_DIA
}

enum AmbienteSefaz {
  HOMOLOGACAO
  PRODUCAO
}

enum OrigemExecucaoSefaz {
  AGENDADA
  MANUAL
}

enum StatusExecucaoSefaz {
  SUCESSO
  SEM_NOVIDADES
  PULADA
  ERRO
  BLOQUEADA
}

enum SituacaoDocumentoSefaz {
  /// Só o resNFe: o XML completo chega depois da Ciência da Operação.
  RESUMO
  COMPLETO
  CANCELADA
}

enum ManifestacaoSefaz {
  PENDENTE
  CIENCIA_ENVIADA
  ERRO
  /// Cancelada ou denegada: não há o que manifestar.
  DISPENSADA
}

enum StatusDocumentoSefaz {
  NOVA
  LANCADA
  DESCARTADA
}

model Usuario {
  id                String        @id @default(cuid())
  nome              String
  email             String        @unique
  senhaHash         String
  role              Role          @default(ESCRITORIO)
  ativo             Boolean       @default(true)
  /// CAMPO: false limita o acesso às obras de `obras` (ADMIN e ESCRITORIO veem todas sempre).
  todasObras        Boolean       @default(true)
  criadoEm          DateTime      @default(now())
  ultimoAcessoEm    DateTime?
  /// Incrementada ao trocar a senha ou encerrar as sessões: JWTs emitidos com outra versão deixam de valer.
  sessaoVersao      Int           @default(0)
  /// Quando a pessoa passou pelo assistente de navegação (pop-up de boas-vindas); nulo = ainda vai ver.
  assistenteVistoEm DateTime?
  /// Até quando a pessoa já viu o aviso de "sua conta foi bloqueada por tentativas"; nulo = desde a criação da conta.
  bloqueioAvisadoEm DateTime?
  obras             UsuarioObra[]
  diarios           DiarioObra[]
  medicoes          Medicao[]
  atividades        Atividade[]
  convitesCriados   Convite[]     @relation("ConviteCriadoPor")
  conviteAceito     Convite?      @relation("ConviteAceito")
  arquivos          Arquivo[]
  linhasBase        LinhaBase[]
  bloqueiosLiberados Bloqueio[]  @relation("BloqueioLiberadoPor")
}

model UsuarioObra {
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  obraId    String
  obra      Obra    @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@id([usuarioId, obraId])
  @@index([obraId])
}

/// O token só existe no link; aqui fica o hash (SHA-256). Uso único.
model Convite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  /// Quando preenchido, o cadastro fica preso a este e-mail.
  email       String?
  nome        String?
  role        Role
  todasObras  Boolean   @default(true)
  obraIds     String[]  @default([])
  criadoPorId String?
  criadoPor   Usuario?  @relation("ConviteCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm    DateTime  @default(now())
  expiraEm    DateTime
  revogadoEm  DateTime?
  usadoEm     DateTime?
  usuarioId   String?   @unique
  usuario     Usuario?  @relation("ConviteAceito", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
}

model Atividade {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tipo       String
  descricao  String
  entidade   String?
  entidadeId String?
  /// Sem FK: o log sobrevive à exclusão da obra.
  obraIds    String[] @default([])
  valorCents Int?
  criadoEm   DateTime @default(now())

  @@index([usuarioId, criadoEm])
  @@index([criadoEm])
  @@index([obraIds], type: Gin)
}

model Obra {
  id         String        @id @default(cuid())
  nome       String
  codigo     String        @unique
  cno        String?
  endereco   String?
  status     StatusObra    @default(ANDAMENTO)
  inicioEm   DateTime?
  etapas     Etapa[]
  rateios    RateioNota[]
  diarios    DiarioObra[]
  usuarios   UsuarioObra[]
  linhasBase LinhaBase[]

  /// `cno` só em dígitos (12): a nota que cita o CNO é ligada à obra por ele. Não é único: um CNO pode cobrir várias obras.
  @@index([cno])
}

model Etapa {
  id             String           @id @default(cuid())
  obraId         String
  obra           Obra             @relation(fields: [obraId], references: [id], onDelete: Cascade)
  nome           String
  ordem          Int
  orcamentoCents Int              @default(0)
  inicioPrevisto DateTime?        @db.Date
  fimPrevisto    DateTime?        @db.Date
  medicoes       Medicao[]
  rateios        RateioNota[]
  linhasBase     LinhaBaseEtapa[]

  @@index([obraId, ordem])
}

/// Foto das datas e do orçamento das etapas num momento: o cronograma mede a variação contra a oficial (uma por obra).
model LinhaBase {
  id       String           @id @default(cuid())
  obraId   String
  obra     Obra             @relation(fields: [obraId], references: [id], onDelete: Cascade)
  nome     String
  oficial  Boolean          @default(false)
  criadaEm DateTime         @default(now())
  autorId  String?
  autor    Usuario?         @relation(fields: [autorId], references: [id], onDelete: SetNull)
  etapas   LinhaBaseEtapa[]

  @@index([obraId, oficial])
}

/// `etapaId` vira nulo se a etapa for excluída: a etapa continua na foto, com o nome da época.
model LinhaBaseEtapa {
  id             String    @id @default(cuid())
  linhaBaseId    String
  linhaBase      LinhaBase @relation(fields: [linhaBaseId], references: [id], onDelete: Cascade)
  etapaId        String?
  etapa          Etapa?    @relation(fields: [etapaId], references: [id], onDelete: SetNull)
  nome           String
  inicio         DateTime? @db.Date
  fim            DateTime? @db.Date
  orcamentoCents Int

  @@index([linhaBaseId])
  @@index([etapaId])
}

model Fornecedor {
  id               String            @id @default(cuid())
  nome             String
  cnpj             String?           @unique
  fone             String?
  obs              String?
  notas            NotaFiscal[]
  apelidosMaterial MaterialApelido[]
}

model NotaFiscal {
  id              String           @id @default(cuid())
  fornecedorId    String
  fornecedor      Fornecedor       @relation(fields: [fornecedorId], references: [id])
  numero          String
  tipoDocumento   TipoDocumento    @default(NF)
  chaveNfe        String?          @unique
  dataCompra      DateTime
  totalCents      Int
  formaPagto      FormaPagto
  obs             String?
  anexoUrl        String?
  anexoNome       String?
  itens           ItemNota[]
  rateios         RateioNota[]
  parcelas        Parcela[]
  documentosSefaz DocumentoSefaz[]
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([fornecedorId, numero])
  @@index([dataCompra])
  @@index([fornecedorId, dataCompra])
}

model ItemNota {
  id            String     @id @default(cuid())
  notaId        String
  nota          NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  descricao     String
  tipo          TipoItem   @default(MATERIAL)
  qtde          Decimal    @db.Decimal(12, 3)
  unidade       String
  unitCents     Int
  descontoCents Int        @default(0)
  totalCents    Int
  materialId    String?
  material      Material?  @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([notaId])
  @@index([materialId])
}

/// Catálogo de materiais: o item do lançamento aponta para cá para somar quantidades e preços entre notas.
model Material {
  id        String            @id @default(cuid())
  nome      String            @unique
  /// Unidade padrão (PC, M, M², M³, KG, SC, L, RL, BR, CX...).
  unidade   String
  tipo      TipoItem          @default(MATERIAL)
  categoria String?
  ativo     Boolean           @default(true)
  criadoEm  DateTime          @default(now())
  apelidos  MaterialApelido[]
  itens     ItemNota[]
}

/// Texto (ou código de produto do fornecedor) que o usuário já ligou a um material: base da ligação automática.
model MaterialApelido {
  id                String      @id @default(cuid())
  materialId        String
  material          Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  /// Descrição normalizada (`chaveMaterial`).
  chave             String      @unique
  descricaoOriginal String
  fornecedorId      String?
  fornecedor        Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  /// `cProd` do XML da NF-e.
  codigoProduto     String?
  criadoEm          DateTime    @default(now())

  @@index([materialId])
  @@index([fornecedorId, codigoProduto])
}

/// Vale para a nota inteira, não por item.
model RateioNota {
  id       String     @id @default(cuid())
  notaId   String
  nota     NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  obraId   String
  obra     Obra       @relation(fields: [obraId], references: [id])
  etapaId  String?
  etapa    Etapa?     @relation(fields: [etapaId], references: [id])
  fracaoBp Int

  @@unique([notaId, obraId])
  @@index([obraId])
}

model Parcela {
  id         String        @id @default(cuid())
  notaId     String
  nota       NotaFiscal    @relation(fields: [notaId], references: [id], onDelete: Cascade)
  numero     Int
  valorCents Int
  vencimento DateTime
  pagaEm     DateTime?
  status     StatusParcela @default(ABERTA)

  @@unique([notaId, numero])
  @@index([status, vencimento])
}

model Medicao {
  id        String   @id @default(cuid())
  etapaId   String
  etapa     Etapa    @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  data      DateTime
  /// Avanço acumulado da etapa.
  percentBp Int
  obs       String?
  autorId   String?
  autor     Usuario? @relation(fields: [autorId], references: [id])

  @@index([etapaId, data])
}

model DiarioObra {
  id           String            @id @default(cuid())
  obraId       String
  obra         Obra              @relation(fields: [obraId], references: [id], onDelete: Cascade)
  data         DateTime          @db.Date
  /// Legado (texto livre); o atual é climaManha/climaTarde.
  clima        String?
  climaManha   String?
  climaTarde   String?
  condicao     CondicaoTrabalho?
  efetivo      Json?
  equipamentos Json?
  atividades   String
  ocorrencias  String?
  fotos        Foto[]
  autorId      String?
  autor        Usuario?          @relation(fields: [autorId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@unique([obraId, data])
}

model Foto {
  id       String     @id @default(cuid())
  diarioId String
  diario   DiarioObra @relation(fields: [diarioId], references: [id], onDelete: Cascade)
  url      String
  legenda  String?

  @@index([url])
  @@index([diarioId])
}

/// Quem enviou pode ler o próprio arquivo antes de ele ser ligado a um RDO ou lançamento.
model Arquivo {
  nome         String   @id
  enviadoPorId String?
  enviadoPor   Usuario? @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)
  tamanhoBytes Int
  criadoEm     DateTime @default(now())

  @@index([enviadoPorId])
}

/// Base do bloqueio por excesso de tentativas; linhas antigas são apagadas.
model TentativaLogin {
  id          String   @id @default(cuid())
  email       String
  ip          String?
  /// id do cookie de aparelho conhecido (services/dispositivo.ts); nulo = aparelho desconhecido
  dispositivo String?
  sucesso     Boolean
  criadoEm    DateTime @default(now())

  @@index([email, criadoEm])
  @@index([ip, criadoEm])
  @@index([dispositivo, criadoEm])
  @@index([criadoEm])
}

/// Ocorrência que conta para uma regra de bloqueio (o "log" que a jail lê): falha (link inválido, arquivo falso)
/// ou uso com limite (IA, OCR). Guardada por poucos dias: só as janelas de contagem precisam dela.
model Infracao {
  id       String   @id @default(cuid())
  /// regra de services/protecao-ativa.ts
  regra    String
  /// IP ou id do usuário, conforme a regra
  chave    String
  criadoEm DateTime @default(now())

  @@index([regra, chave, criadoEm])
  @@index([criadoEm])
}

/// Bloqueio aplicado por excesso de falhas (a "jail" do Fail2ban). Fica no banco para valer em todas as instâncias,
/// para o bloqueio crescer na reincidência e para o admin ver e liberar antes do prazo.
model Bloqueio {
  id            String    @id @default(cuid())
  /// "login-email", "login-ip" ou uma regra de services/protecao-ativa.ts
  regra         String
  /// e-mail normalizado, IP ou id do usuário, conforme a regra
  chave         String
  ate           DateTime
  motivo        String
  liberadoEm    DateTime?
  liberadoPorId String?
  liberadoPor   Usuario?  @relation("BloqueioLiberadoPor", fields: [liberadoPorId], references: [id], onDelete: SetNull)
  criadoEm      DateTime  @default(now())

  @@index([chave, criadoEm])
  @@index([ate])
  @@index([criadoEm])
  @@index([liberadoPorId])
}

/// Posição na fila de distribuição da Sefaz (NFeDistribuicaoDFe), uma por CNPJ consultado.
/// Consultar fora da sequência de NSU ou antes da janela de 1 h leva a bloqueio (cStat 656).
model CursorSefaz {
  cnpj              String    @id
  ultNsu            String    @default("000000000000000")
  maxNsu            String    @default("000000000000000")
  /// Antes disso a Sefaz não deve ser consultada (fim da fila ou resposta 137).
  proximaConsultaEm DateTime?
  bloqueadoAte      DateTime?
  /// Trava de execução: duas consultas simultâneas quebrariam a sequência de NSU.
  travadoAte        DateTime?
  ultimoCStat       String?
  ultimoMotivo      String?
  ultimaConsultaEm  DateTime?
  atualizadoEm      DateTime  @updatedAt
}

model ExecucaoSefaz {
  id             String              @id @default(cuid())
  cnpj           String
  origem         OrigemExecucaoSefaz
  status         StatusExecucaoSefaz
  iniciadaEm     DateTime            @default(now())
  finalizadaEm   DateTime?
  nsuInicial     String?
  nsuFinal       String?
  lotes          Int                 @default(0)
  docsRecebidos  Int                 @default(0)
  ciencias       Int                 @default(0)
  cStat          String?
  mensagem       String?
  duracaoMs      Int?
  disparadaPorId String?

  @@index([iniciadaEm])
  @@index([cnpj, iniciadaEm])
}

/// NF-e emitida contra o CNPJ da empresa, achada na distribuição da Sefaz. Vira NotaFiscal pelo fluxo de importação.
model DocumentoSefaz {
  id               String                 @id @default(cuid())
  chave            String                 @unique
  nsu              String
  cnpjDestinatario String
  emitenteDoc      String
  emitenteNome     String
  numero           String
  serie            String
  dataEmissao      DateTime
  valorCents       Int
  /// CNO da obra citado no XML (só dígitos), para mostrar a obra na caixa de recebidas.
  cno              String?
  situacao         SituacaoDocumentoSefaz
  manifestacao     ManifestacaoSefaz      @default(PENDENTE)
  manifestacaoErro String?
  manifestadoEm    DateTime?
  /// procNFe guardado no storage (só quando COMPLETO).
  xmlUrl           String?
  status           StatusDocumentoSefaz   @default(NOVA)
  notaFiscalId     String?
  notaFiscal       NotaFiscal?            @relation(fields: [notaFiscalId], references: [id], onDelete: SetNull)
  descartadoPorId  String?
  recebidoEm       DateTime               @default(now())
  atualizadoEm     DateTime               @updatedAt

  @@index([status, situacao, dataEmissao(sort: Desc)])
  @@index([dataEmissao])
  @@index([recebidoEm])
  @@index([manifestacao])
  @@index([notaFiscalId])
}

/// Empresa dona da plataforma (registro único, id "principal"): dados, CNPJs e o certificado A1 da captura Sefaz.
model Empresa {
  id                      String            @id @default("principal")
  razaoSocial             String
  nomeFantasia            String?
  /// CNPJ da matriz, só dígitos e letras (CNPJ alfanumérico).
  cnpj                    String
  /// CNPJs das filiais que também recebem notas.
  filiais                 String[]          @default([])
  /// Sigla da UF (PR, SP...): vira o cUFAutor da consulta à Sefaz.
  uf                      String            @default("PR")
  capturaAtiva            Boolean           @default(false)
  ambienteSefaz           AmbienteSefaz     @default(HOMOLOGACAO)
  /// Quantas vezes por dia a busca automática consulta a Sefaz (horários fixos, ver sefaz/regras.ts).
  frequenciaCaptura       FrequenciaCaptura @default(UMA_VEZ_DIA)
  /// PEM (chave + certificado) cifrado com AES-256-GCM (lib/cofre.ts); a senha do .pfx não é guardada.
  certificadoCifrado      Bytes?
  certificadoTitular      String?
  certificadoCnpj         String?
  /// Autoridade Certificadora que emitiu (ex.: AC SERASA RFB v5).
  certificadoEmissor      String?
  certificadoValidoDesde  DateTime?
  certificadoValidoAte    DateTime?
  certificadoEnviadoEm    DateTime?
  certificadoEnviadoPorId String?
  atualizadoEm            DateTime          @updatedAt
}
