generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ESCRITORIO
  CAMPO
}

enum StatusObra {
  PLANEJAMENTO
  ANDAMENTO
  CONCLUIDA
  PAUSADA
}

enum TipoItem {
  MATERIAL
  SERVICO
  FRETE
  ENCARGO
}

enum FormaPagto {
  PIX
  CARTAO
  DEBITO
  BOLETO
}

enum StatusParcela {
  ABERTA
  PAGA
}

model Usuario {
  id        String       @id @default(cuid())
  nome      String
  email     String       @unique
  senhaHash String
  role      Role         @default(ESCRITORIO)
  ativo     Boolean      @default(true)
  diarios   DiarioObra[]
  medicoes  Medicao[]
}

model Obra {
  id       String       @id @default(cuid())
  nome     String // "Lote 03"
  codigo   String       @unique
  cno      String? // Cadastro Nacional de Obras
  endereco String?
  status   StatusObra   @default(ANDAMENTO)
  inicioEm DateTime?
  etapas   Etapa[]
  rateios  RateioItem[]
  diarios  DiarioObra[]
}

model Etapa {
  id             String       @id @default(cuid())
  obraId         String
  obra           Obra         @relation(fields: [obraId], references: [id], onDelete: Cascade)
  nome           String // "Fundação", "Acabamento"...
  ordem          Int
  orcamentoCents Int          @default(0) // previsto
  medicoes       Medicao[]
  rateios        RateioItem[] // realizado por etapa (opcional no item)
}

model Fornecedor {
  id    String       @id @default(cuid())
  nome  String
  cnpj  String?      @unique
  fone  String?
  obs   String?
  notas NotaFiscal[]
}

model NotaFiscal {
  id           String     @id @default(cuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  numero       String
  dataCompra   DateTime
  totalCents   Int // valor da nota
  formaPagto   FormaPagto
  obs          String?
  itens        ItemNota[]
  parcelas     Parcela[]
  createdBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([fornecedorId, numero])
  @@index([dataCompra])
}

model ItemNota {
  id            String       @id @default(cuid())
  notaId        String
  nota          NotaFiscal   @relation(fields: [notaId], references: [id], onDelete: Cascade)
  descricao     String
  tipo          TipoItem     @default(MATERIAL)
  qtde          Decimal      @db.Decimal(12, 3)
  unidade       String // PC, KG, M², MO...
  unitCents     Int
  descontoCents Int          @default(0)
  totalCents    Int
  rateios       RateioItem[]
}

model RateioItem {
  id       String   @id @default(cuid())
  itemId   String
  item     ItemNota @relation(fields: [itemId], references: [id], onDelete: Cascade)
  obraId   String
  obra     Obra     @relation(fields: [obraId], references: [id])
  etapaId  String?
  etapa    Etapa?   @relation(fields: [etapaId], references: [id])
  fracaoBp Int // basis points: 10000 = 100%

  @@unique([itemId, obraId])
  @@index([obraId])
}

model Parcela {
  id         String        @id @default(cuid())
  notaId     String
  nota       NotaFiscal    @relation(fields: [notaId], references: [id], onDelete: Cascade)
  numero     Int // 1..6
  valorCents Int
  vencimento DateTime
  pagaEm     DateTime?
  status     StatusParcela @default(ABERTA)

  @@unique([notaId, numero])
  @@index([vencimento, status])
}

model Medicao {
  id        String   @id @default(cuid())
  etapaId   String
  etapa     Etapa    @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  data      DateTime
  percentBp Int // avanço acumulado da etapa
  obs       String?
  autorId   String?
  autor     Usuario? @relation(fields: [autorId], references: [id])
}

model DiarioObra {
  id          String   @id @default(cuid())
  obraId      String
  obra        Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  data        DateTime @db.Date
  clima       String? // "Sol / Chuva à tarde"
  efetivo     Json? // [{funcao:"pedreiro", qtd:4}, ...]
  atividades  String
  ocorrencias String?
  fotos       Foto[]
  autorId     String?
  autor       Usuario? @relation(fields: [autorId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([obraId, data])
  @@index([obraId, data])
}

model Foto {
  id       String     @id @default(cuid())
  diarioId String
  diario   DiarioObra @relation(fields: [diarioId], references: [id], onDelete: Cascade)
  url      String
  legenda  String?
}
