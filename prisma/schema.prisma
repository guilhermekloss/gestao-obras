generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ESCRITORIO
  CAMPO
}

enum StatusObra {
  PLANEJAMENTO
  ANDAMENTO
  CONCLUIDA
  PAUSADA
}

enum TipoItem {
  MATERIAL
  SERVICO
  FRETE
  ENCARGO
}

enum FormaPagto {
  PIX
  CARTAO
  DEBITO
  BOLETO
  TRANSFERENCIA
  DINHEIRO
}

/**
 * Documento que origina o custo — NF é o padrão; os demais cobrem custos sem nota (mão de obra, impostos, taxas).
 */
enum TipoDocumento {
  NF
  RECIBO
  FOLHA
  GUIA
  OUTRO
}

/**
 * Condição de trabalho registrada no RDO.
 */
enum CondicaoTrabalho {
  PRATICAVEL
  PARCIAL
  IMPRATICAVEL
}

enum StatusParcela {
  ABERTA
  PAGA
}

model Usuario {
  id              String        @id @default(cuid())
  nome            String
  email           String        @unique
  senhaHash       String
  role            Role          @default(ESCRITORIO)
  ativo           Boolean       @default(true)
  /**
   * CAMPO: false limita o acesso às obras de `obras` (ADMIN e ESCRITORIO veem todas sempre).
   */
  todasObras      Boolean       @default(true)
  criadoEm        DateTime      @default(now())
  /**
   * Atualizado no login e a cada uso (no máximo a cada poucos minutos).
   */
  ultimoAcessoEm  DateTime?
  obras           UsuarioObra[]
  diarios         DiarioObra[]
  medicoes        Medicao[]
  atividades      Atividade[]
  convitesCriados Convite[]     @relation("ConviteCriadoPor")
  conviteAceito   Convite?      @relation("ConviteAceito")
}

/**
 * Obras liberadas para um usuário com `todasObras = false`.
 */
model UsuarioObra {
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  obraId    String
  obra      Obra    @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@id([usuarioId, obraId])
  @@index([obraId])
}

/**
 * Link de cadastro: o admin gera, envia, e a pessoa cria a própria conta com o papel e as obras do convite.
 * O token só existe no link — aqui fica o hash (SHA-256). Uso único.
 */
model Convite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  /**
   * Quando preenchido, o cadastro fica preso a este e-mail.
   */
  email       String?
  nome        String?
  role        Role
  todasObras  Boolean   @default(true)
  obraIds     String[]  @default([])
  criadoPorId String?
  criadoPor   Usuario?  @relation("ConviteCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm    DateTime  @default(now())
  expiraEm    DateTime
  revogadoEm  DateTime?
  usadoEm     DateTime?
  usuarioId   String?   @unique
  usuario     Usuario?  @relation("ConviteAceito", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
}

/**
 * Log de auditoria: uma linha por ação de escrita bem-sucedida (gravada por `acaoDeEscrita`).
 */
model Atividade {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tipo       String // "nota.salvar", "rdo.criar"... (ver services/atividade.ts)
  descricao  String
  entidade   String? // "nota" | "rdo" | "obra" | "fornecedor" | "usuario" | "convite" | "medicao"
  entidadeId String?
  /**
   * Obras afetadas (uma nota rateada toca várias) — sem FK: o log sobrevive à exclusão da obra.
   */
  obraIds    String[] @default([])
  valorCents Int?
  criadoEm   DateTime @default(now())

  @@index([usuarioId, criadoEm])
  @@index([criadoEm])
  @@index([obraIds], type: Gin)
}

model Obra {
  id       String        @id @default(cuid())
  nome     String // "Lote 03"
  codigo   String        @unique
  cno      String? // Cadastro Nacional de Obras
  endereco String?
  status   StatusObra    @default(ANDAMENTO)
  inicioEm DateTime?
  etapas   Etapa[]
  rateios  RateioNota[]
  diarios  DiarioObra[]
  usuarios UsuarioObra[]
}

model Etapa {
  id             String       @id @default(cuid())
  obraId         String
  obra           Obra         @relation(fields: [obraId], references: [id], onDelete: Cascade)
  nome           String // "Fundação", "Acabamento"...
  ordem          Int
  orcamentoCents Int          @default(0) // previsto
  inicioPrevisto DateTime?    @db.Date // cronograma (linha de base)
  fimPrevisto    DateTime?    @db.Date
  medicoes       Medicao[]
  rateios        RateioNota[] // realizado por etapa (opcional na nota)
}

model Fornecedor {
  id    String       @id @default(cuid())
  nome  String
  cnpj  String?      @unique
  fone  String?
  obs   String?
  notas NotaFiscal[]
}

model NotaFiscal {
  id            String        @id @default(cuid())
  fornecedorId  String
  fornecedor    Fornecedor    @relation(fields: [fornecedorId], references: [id])
  numero        String
  tipoDocumento TipoDocumento @default(NF)
  /**
   * Chave de acesso da NF-e (44 dígitos) quando importada do XML — evita importar a mesma nota duas vezes.
   */
  chaveNfe      String?       @unique
  dataCompra    DateTime
  totalCents    Int // valor da nota
  formaPagto    FormaPagto
  obs           String?
  anexoUrl      String?
  anexoNome     String? // nome original do arquivo, para exibir no link
  itens         ItemNota[]
  rateios       RateioNota[] // rateio se aplica à nota inteira, não a itens individuais
  parcelas      Parcela[]
  createdBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([fornecedorId, numero])
  @@index([dataCompra])
  @@index([fornecedorId])
}

model ItemNota {
  id            String     @id @default(cuid())
  notaId        String
  nota          NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  descricao     String
  tipo          TipoItem   @default(MATERIAL)
  qtde          Decimal    @db.Decimal(12, 3)
  unidade       String // PC, KG, M², MO...
  unitCents     Int
  descontoCents Int        @default(0)
  totalCents    Int

  @@index([notaId])
}

/**
 * Rateio entre obras: se aplica a todos os itens da nota (ver README §Pendências conscientes).
 */
model RateioNota {
  id       String     @id @default(cuid())
  notaId   String
  nota     NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  obraId   String
  obra     Obra       @relation(fields: [obraId], references: [id])
  etapaId  String?
  etapa    Etapa?     @relation(fields: [etapaId], references: [id])
  fracaoBp Int // basis points: 10000 = 100%

  @@unique([notaId, obraId])
  @@index([obraId])
}

model Parcela {
  id         String        @id @default(cuid())
  notaId     String
  nota       NotaFiscal    @relation(fields: [notaId], references: [id], onDelete: Cascade)
  numero     Int // 1..6
  valorCents Int
  vencimento DateTime
  pagaEm     DateTime?
  status     StatusParcela @default(ABERTA)

  @@unique([notaId, numero])
  @@index([vencimento, status])
  @@index([notaId])
}

model Medicao {
  id        String   @id @default(cuid())
  etapaId   String
  etapa     Etapa    @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  data      DateTime
  percentBp Int // avanço acumulado da etapa
  obs       String?
  autorId   String?
  autor     Usuario? @relation(fields: [autorId], references: [id])

  @@index([etapaId])
}

model DiarioObra {
  id           String            @id @default(cuid())
  obraId       String
  obra         Obra              @relation(fields: [obraId], references: [id], onDelete: Cascade)
  data         DateTime          @db.Date
  clima        String? // legado, texto livre: "Sol / Chuva à tarde"
  climaManha   String? // "SOL" | "NUBLADO" | "CHUVA"...
  climaTarde   String?
  condicao     CondicaoTrabalho?
  efetivo      Json? // [{funcao:"pedreiro", qtd:4}, ...]
  equipamentos Json? // [{nome:"betoneira", qtd:1}, ...]
  atividades   String
  ocorrencias  String?
  fotos        Foto[]
  autorId      String?
  autor        Usuario?          @relation(fields: [autorId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@unique([obraId, data])
  @@index([obraId, data])
}

model Foto {
  id       String     @id @default(cuid())
  diarioId String
  diario   DiarioObra @relation(fields: [diarioId], references: [id], onDelete: Cascade)
  url      String
  legenda  String?
}
